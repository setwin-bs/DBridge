+        await asyncio.wait_for(task, timeout=2)
+
+    async def test_failures_do_not_accumulate_connections(self):
+        """AC-10: failures driven through spawn_agents must not grow live connections."""
+        state = {"now": 0, "max": 0, "accepted": 0}
